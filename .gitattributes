# Normalize text files to LF.
* text=auto eol=lf

# Keep images, fonts, and archives binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary

# SVGs are text; the lockfile is generated.
*.svg text
pnpm-lock.yaml linguist-generated=true
