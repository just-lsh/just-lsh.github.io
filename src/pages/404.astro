---
import Prompt from "../components/Prompt.astro";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";

const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<Base title={`Page not found — ${site.name}`} description="This page could not be found.">
  <section aria-labelledby="missing-prompt" class="mb-7">
    <Prompt id="missing-prompt" command="cd <path>" />
    <h1 class="mt-1.5 text-[28px] leading-[1.2] font-semibold tracking-[-0.5px]">Page not found</h1>
    <p class="mt-1.5">cd: no such file or directory</p>
    <p class="mt-1.5"><a class="text-accent" href={home}>Return home</a></p>
  </section>
</Base>
