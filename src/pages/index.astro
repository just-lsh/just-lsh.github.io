---
import Listing, { type Row } from "../components/listing.astro";
import Prompt from "../components/prompt.astro";
import { site } from "../data/site";
import Base from "../layouts/base.astro";
import { workDuration } from "../lib/work-duration";

const paragraphs = Array.isArray(site.bio) ? site.bio : [site.bio];
const buildDate = new Date();
const workRows: Row[] = [...site.work]
  .sort((a, b) => b.start.localeCompare(a.start))
  .map((entry) => ({
    icon: "mdi:briefcase",
    date: `${entry.start} → ${entry.end ?? "now"}`,
    meta: workDuration(entry.start, entry.end, buildDate),
    name: entry.company,
    href: entry.url,
    detail: entry.role,
    description: entry.description,
  }));
const projectRows: Row[] = site.projects.map((project) => ({
  icon: project.icon ?? "mdi:source-repository",
  date: project.date,
  name: project.name,
  href: project.url,
  description: project.description,
}));
---

<Base title={site.name} description={`${site.name} — ${site.role}. Personal website.`}>
  <section aria-labelledby="name" class="mb-7">
    <div aria-hidden="true"><Prompt as="p" command="whoami" /></div>
    <h1 id="name" class="mt-1.5 mb-0.5 text-[28px] leading-[1.2] font-semibold tracking-[-0.5px]">{site.name}</h1>
    <p class="text-string">{site.role}</p>
  </section>
  <section id="about" aria-labelledby="about-prompt" class="mb-7">
    <Prompt id="about-prompt" command="cat about.txt" />
    {paragraphs.map((paragraph) => <p class="mt-1.5">{paragraph}</p>)}
  </section>
  <section id="work" aria-labelledby="work-prompt" class="mb-7">
    <Prompt id="work-prompt" command="ls -l work/" />
    <Listing caption="Work: dates, duration, company, role, and description" rows={workRows} />
  </section>
  <section id="projects" aria-labelledby="projects-prompt" class="mb-7">
    <Prompt id="projects-prompt" command="ls -l projects/" />
    <Listing caption="Projects: date, name, and description" rows={projectRows} />
  </section>
  <section id="contact" aria-labelledby="contact-prompt" class="mb-7">
    <Prompt id="contact-prompt" command="cat contact" />
    <dl class="mt-1.5">
      {site.links.map((link) => (
        <div class="flex gap-0"><dt class="w-[9ch] shrink-0 whitespace-nowrap text-comment">{link.label}</dt><dd class="min-w-0"><a class="syntax-link" href={link.href} rel="me noopener">{link.text.split(/(?<=[@./])/u).map((part, index) => <>{index > 0 && <wbr />}{part}</>)}</a></dd></div>
      ))}
    </dl>
  </section>
  <div aria-hidden="true" class="mb-7">
    <Prompt as="p"><span class="cursor-blink inline-block h-[1.1em] w-[0.6em] align-[-2px] bg-cursor"></span></Prompt>
  </div>
</Base>
