---
interface Props {
  command?: string;
  id?: string;
  as?: "h2" | "p";
}
const { command, id, as: Tag = "h2" } = Astro.props;
---

<Tag id={id} class="m-0 text-[length:inherit] font-normal text-comment">
  <span class="text-keyword">~</span> $ <span class="text-fg">{command}</span><slot />
</Tag>
